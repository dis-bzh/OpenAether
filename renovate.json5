// Renovate (GitHub App). Nothing here runs unattended: every bump is a
// PR, never auto-merged — applying a Talos/Kubernetes/provider bump still
// goes through `task rolling-replace` / `tofu plan` by hand.
//
// Native managers cover OpenTofu providers (`terraform`) and CI pins
// (`github-actions`). Everything else — Talos, Kubernetes, the OpenTofu CLI
// itself, Cilium, Flux — lives in a bash var, a Taskfile default or a
// Terraform variable default, which Renovate can't see on its own. Those are
// tracked with the standard `# renovate: datasource=... depName=...` anchor
// comment placed one line above the value; see customManagers below.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  automerge: false,
  platformAutomerge: false,
  schedule: ["before 6am on monday"],
  timezone: "Europe/Paris",
  labels: ["dependencies"],

  packageRules: [
    {
      description: "Routine OpenTofu provider bumps, bundled. Majors stay separate — bpg/proxmox and outscale/outscale in particular have no 1.0 yet and move fast on schema.",
      matchManagers: ["terraform"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "opentofu providers (minor/patch)",
    },
    {
      description: "GitHub Actions are isolated to CI, low risk — safe to bundle.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: "Talos/Kubernetes gate a running cluster's control plane. Bumping is a one-node-at-a-time `task rolling-replace`, never automated — see docs/backlog.md.",
      matchPackageNames: ["siderolabs/talos", "kubernetes/kubernetes"],
      labels: ["dependencies", "cluster-version"],
    },
    {
      description: "Cilium/Flux versions here only bump the pinned variable. The actual manifest (bootstrap-manifests/cilium.yaml, flux-install.yaml) is regenerated by `task up FORCE=1` — run that and commit the diff before merging.",
      matchPackageNames: ["cilium", "fluxcd/flux2"],
      labels: ["dependencies", "needs-regen"],
    },
  ],

  customManagers: [
    {
      customType: "regex",
      description: "Terraform variable defaults (talos_version, kubernetes_version) — the `terraform` manager only reads required_providers, not variable defaults.",
      fileMatch: ["^infrastructure/opentofu/cluster/variables\\.tf$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      customType: "regex",
      description: "Taskfile.yml VERSION defaults (talos-image, up) — same Talos pin, kept in sync with cluster/variables.tf by this same tracker.",
      fileMatch: ["^Taskfile\\.yml$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*VERSION: '\\{\\{\\.VERSION \\| default \"(?<currentValue>[^\"]+)\"\\}\\}'",
      ],
    },
    {
      customType: "regex",
      description: "render-bootstrap-manifests.sh: CILIUM_VERSION and FLUX_VERSION, bash `VAR=\"${VAR:-default}\"` form.",
      fileMatch: ["^scripts/bootstrap/render-bootstrap-manifests\\.sh$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\w+=\"\\$\\{\\w+:-(?<currentValue>[^}]+)\\}\"",
      ],
    },
    {
      customType: "regex",
      description: "setup.sh install_flux(): the Flux CLI version for local dev, `local VAR=\"value\"` form (no leading v — extractVersion strips it from the fetched tag).",
      fileMatch: ["^scripts/setup\\.sh$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*local \\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      customType: "regex",
      description: "ci.yml: the OpenTofu CLI version fed to opentofu/setup-opentofu's `with:` input — the github-actions manager only bumps the action's own `uses:` pin, not this.",
      fileMatch: ["^\\.github/workflows/ci\\.yml$"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*tofu_version:\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
}
