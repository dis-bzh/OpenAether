# ==============================================================================
# Management Cluster — OVH Public Cloud (hub)
# Hosts ArgoCD (hub), OpenBao, Keycloak, VictoriaMetrics. NOT in the client
# data path. Use this when OVH is your PRIMARY management provider.
#
# Prerequisites:
#   export OS_AUTH_URL=https://auth.cloud.ovh.net/v3
#   export OS_USERNAME=<ovh_user>
#   export OS_PASSWORD=<ovh_password>
#   export OS_PROJECT_ID=<ovh_project_id>
#   export OS_REGION_NAME=GRA11
# ==============================================================================

cluster_name       = "openaether"
environment        = "prod"
cluster_role       = "management"
talos_version      = "v1.13.3"
kubernetes_version = "v1.35.3"
talos_bootstrap    = true

node_distribution = {
  ovh = {
    control_planes     = 3
    workers            = 2
    region             = "GRA11"
    flavor_name        = "b2-7"
    image_id           = "TALOS_IMAGE_ID" # Replace with actual OVH image UUID
    network_name       = "Ext-Net"
    availability_zones = ["nova"]
    bastion_image_id   = "Ubuntu 22.04"
  }
}

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  ovh = "ssh-ed25519 AAAA... user@host"
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether.git"
argocd_namespace = "management-gitops"

# --- Backup / DR object stores (OVH S3-compatible Object Storage) -------------
# Derived buckets: state -> s3-openaether-ovh-tfstate-prod (+ -backup),
#                  kube/talos -> s3-openaether-ovh-management-prod (+ -backup).
# PRIMARY = OVH (AWS_*). REPLICA = the "-backup" store; in prod point it at a
# DIFFERENT provider (e.g. Scaleway) + export BACKUP_AWS_* for it.
s3_primary_endpoint = "https://s3.gra.io.cloud.ovh.net"
s3_primary_region   = "gra"
s3_replica_endpoint = "https://s3.gra.io.cloud.ovh.net" # prod: e.g. SCW https://s3.fr-par.scw.cloud
s3_replica_region   = "gra"                              # prod: e.g. fr-par
