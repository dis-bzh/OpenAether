# OpenAether — Flux bootstrap manifest (template)
# Injecté en inline_manifest Talos lors du bootstrap initial.
# Remplace flux-root-app.yaml.tftpl.
#
# Variables OpenTofu :
#   ${git_repo_url}   — ex: https://github.com/dis-bzh/OpenAether.git
#   ${git_branch}     — ex: main
#   ${cluster_role}   — ex: management (→ apps/flux/management)
#   ${cluster_id}     — ex: openaether-dev-ovh (identité UNIQUE du cluster)
#   ${namespace}      — ex: flux-system
---
# Identité du cluster, consommée par `postBuild.substituteFrom` des briques qui
# doivent se distinguer d'un AUTRE cluster. Aujourd'hui : le chemin des dépôts
# restic (apps/flux/base/22-backup.yaml), car plusieurs clusters partagent des
# buckets cross-provider et un dépôt restic n'est lisible qu'avec le
# RESTIC_PASSWORD du cluster qui l'a créé — deux clusters sur le même chemin se
# bloquent mutuellement (« already initialized »).
#
# ⚠️ Une brique qui déclare `substituteFrom` ce ConfigMap ÉCHOUE s'il est absent.
# C'est volontaire : mieux vaut un échec bruyant qu'un chemin de dépôt vide et
# une collision silencieuse entre clusters.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-identity
  namespace: ${namespace}
  labels:
    openaether.io/managed: "true"
data:
  CLUSTER_NAME: ${cluster_id}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: openaether
  namespace: ${namespace}
spec:
  interval: 1m
  url: ${git_repo_url}
  ref:
    branch: ${git_branch}
  timeout: 60s
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: openaether-platform
  namespace: ${namespace}
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 5m
  sourceRef:
    kind: GitRepository
    name: openaether
  path: ./apps/flux/${cluster_role}
  prune: true
  wait: false
  # Injecte la branche dans les objets du layer flux (dont le GitRepository
  # auto-réappliqué — piège gitception : sans ça, une branche de test se fait
  # écraser par le `main` en dur au premier reconcile).
  postBuild:
    substitute:
      GIT_BRANCH: ${git_branch}
