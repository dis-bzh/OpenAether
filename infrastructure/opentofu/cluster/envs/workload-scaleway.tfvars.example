# ==============================================================================
# Workload Cluster — Scaleway (spoke)
# Client applications cluster. Managed by the management cluster via ArgoCD hub.
# ==============================================================================

cluster_name       = "openaether-scaleway"
environment        = "prod"
cluster_role       = "workload"
talos_version      = "v1.13.3"
kubernetes_version = "v1.35.3"
talos_bootstrap    = true

node_distribution = {
  scaleway = {
    control_planes = 3
    workers        = 3
    region         = "fr-par"
    zone           = "fr-par-1"
    instance_type  = "DEV1-M"
    image_name     = "talos-scaleway-amd64-v1.13.3"
    zones          = ["fr-par-1", "fr-par-2", "fr-par-3"]
  }
}

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  scaleway = "ssh-ed25519 AAAA... user@host"
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether-apps.git"
argocd_namespace = "management-gitops"

# --- Backup / DR object stores ------------------------------------------------
# Derived buckets: state -> s3-openaether-scaleway-tfstate-prod (+ -backup),
#                  kube/talos -> s3-openaether-scaleway-workload-prod (+ -backup).
# PRIMARY = this cluster's provider (AWS_*). REPLICA = the "-backup" store; in
# prod point it at a DIFFERENT provider + export BACKUP_AWS_* for it.
s3_primary_endpoint = "https://s3.fr-par.scw.cloud"
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.fr-par.scw.cloud" # prod: e.g. OVH https://s3.gra.io.cloud.ovh.net
s3_replica_region   = "fr-par"                       # prod: e.g. gra
