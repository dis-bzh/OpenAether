# ==============================================================================
# Management Cluster — Scaleway HA (3 zones)
# This cluster hosts ArgoCD (hub), OpenBao, Keycloak, VictoriaMetrics.
# It is NOT in the data path of client workloads.
# ==============================================================================

cluster_name       = "openaether"
environment        = "prod"
cluster_role       = "management"
talos_version      = "v1.13.3"
kubernetes_version = "v1.35.3"
talos_bootstrap    = true
node_distribution = {
  scaleway = {
    control_planes = 3 # HA needs 3; new Scaleway accounts may have a per-type quota of 1 — request an increase (Console → Quotas) or start with 1
    workers        = 2
    region         = "fr-par"
    zone           = "fr-par-1"
    instance_type  = "POP2-2C-8G" # block-storage, dedicated CPU, in all 3 fr-par zones (DEV1-M is l_ssd + not in fr-par-3)
    image_name     = "talos-scaleway-amd64-v1.13.3"
    zones          = ["fr-par-1", "fr-par-2", "fr-par-3"]
  }
}

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  scaleway = "ssh-ed25519 AAAA... user@host"
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether.git"
argocd_namespace = "management-gitops"

# --- Backup / DR object stores ------------------------------------------------
# Derived buckets (you don't set them):
#   state          -> s3-openaether-scaleway-tfstate-prod      (+ -backup)
#   kube/talosconfig -> s3-openaether-scaleway-management-prod  (+ -backup)
# PRIMARY = this cluster's provider (uses AWS_*). REPLICA = the "-backup" store.
# In PROD, point the replica at a DIFFERENT provider and export
# BACKUP_AWS_ACCESS_KEY_ID / BACKUP_AWS_SECRET_ACCESS_KEY for it. In dev, leave
# the replica equal to the primary (replica creds then default to AWS_*).
s3_primary_endpoint = "https://s3.fr-par.scw.cloud"
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.fr-par.scw.cloud" # prod: e.g. OVH https://s3.gra.io.cloud.ovh.net
s3_replica_region   = "fr-par"                       # prod: e.g. gra
